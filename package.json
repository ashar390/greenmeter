{
  "name": "greenmeter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "preview": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev",
    "deploy": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "cf:typegen": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply greenmeter-db --local",
    "db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply greenmeter-db --remote",
    "db:seed:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 execute greenmeter-db --local --file=db/seed-demo.sql",
    "db:seed:remote": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 execute greenmeter-db --remote --file=db/seed-demo.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@auth/d1-adapter": "^1.11.3",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
